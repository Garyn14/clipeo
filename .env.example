ANTHROPIC_API_KEY=      # requerida por todos los agentes que llaman a Claude
HF_TOKEN=                # opcional, activa diarización de hablantes (pyannote)
COLAB_TRANSCRIBE_URL=   # URL del endpoint /transcribe, ej: https://algo.trycloudflare.com/transcribe
                        # también habilita /live/check en el mismo túnel (misma base URL) para verificar
                        # lives de TikTok desde la IP de Colab, evitando el bloqueo de WAF a la IP local
COLAB_AUTH_TOKEN=       # opcional, debe coincidir con AUTH_TOKEN del notebook
