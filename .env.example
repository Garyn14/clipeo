# Copiar a legacy/.env (el piloto lo busca en su carpeta de trabajo). Todo es opcional.
AI_PROVIDER=            # claude_cli (default: usa Claude Code de la máquina, sin API) | anthropic | manual
AI_CLI_MODEL=           # opcional, default "sonnet" (solo claude_cli)
ANTHROPIC_API_KEY=      # solo para AI_PROVIDER=anthropic
HF_TOKEN=               # opcional, activa diarización de hablantes (pyannote)
COLAB_TRANSCRIBE_URL=   # URL del túnel, con o sin /transcribe, ej: https://algo.trycloudflare.com (se relee en cada intento)
                        # también habilita /live/check en el mismo túnel para verificar lives de TikTok desde la IP de Colab
COLAB_AUTH_TOKEN=       # opcional, debe coincidir con AUTH_TOKEN del notebook
FFMPEG_BIN_DIR=         # opcional: carpeta de ffmpeg si no está en el PATH (en Windows se busca sola la instalación de WinGet)
